# ===========================
# Tipos y enums principales
# ===========================

type Operation {
  idOperation: ID!
  idOperationMessage: Int
  idOrganization: Int
  operationType: String
  activate: Boolean
  dateRegistration: String
  dateModification: String
}


# --- Tipo para los detalles individuales ---
type DonationDetail {
  description: String
  quantity: Int
}


# --- Tipo principal del reporte ---
type DonationReport {
  category: Category
  activate: Boolean
  totalQuantity: Int
  details: [DonationDetail]
}

enum Category {
  ROPA
  ALIMENTO
  JUGUETE
  UTIL_ESCOLAR
}

enum DeletedStatus {
  SI
  NO
  AMBOS
}

type SavedFilter {
  id: ID!
  userId: ID!
  name: String!
  category: Category
  startDate: String
  endDate: String
  deletedStatus: DeletedStatus
}

input SavedFilterInputDTO {
  userId: ID!
  name: String!
  category: Category
  startDate: String
  endDate: String
  deletedStatus: DeletedStatus
}

# ===========================
# Queries
# ===========================
type Query {
  
  operations: [Operation!]!

  donationReport(
    category: Category,
    startDate: String,
    endDate: String,
    activate: Boolean,
    isExternal: Boolean
    
  ): [DonationReport!]!

  getSavedFilters(userId: ID!): [SavedFilter!]!
}

# ===========================
# Mutations
# ===========================
type Mutation {
  saveFilter(input: SavedFilterInputDTO!): SavedFilter!
  updateFilter(id: ID!, input: SavedFilterInputDTO!): SavedFilter!
  deleteStatus(id: ID!): Boolean!
}
